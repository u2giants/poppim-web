{
  "exclude": ["shared-db/**", "node_modules/**", "dist/**", ".claude/**", ".github/**"],
  "router": "AGENTS.md",
  "router_max_bytes": 25000,
  "living_max_bytes": 60000,
  "handoff_dir": "HANDOFF.d",
  "handoff_max_age_days": 30,
  "index": "docs/INDEX.md",
  "header_exempt": ["AGENTS.md", "CLAUDE.md", "README.md", "HANDOFF.md", "HANDOFF.d/**"],
  "root_markdown_allow": ["AGENTS.md", "CLAUDE.md", "README.md", "HANDOFF.md", "plan_*.md", "fix_*.md", "bugs.md", "gaps.md"]
}
